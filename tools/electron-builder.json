{
  "appId": "com.wangcangxing.fixpoint",
  "productName": "Fixpoint",
  "copyright": "Powered by wangcangxing",
  "electronVersion": "44.7.2",
  "directories": {
    "output": "build/installer"
  },
  "win": {
    "icon": "assets/fixpoint.ico",
